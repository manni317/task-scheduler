# =============================================================================
# Muze Satwik Task Manager - Environment Variables Template
# =============================================================================
# Copy this file to .env.local for local development
# For production, set these in Cloudflare Pages dashboard and GitHub Secrets
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (Backend Database & Auth)
# -----------------------------------------------------------------------------
# Get these from: https://supabase.com/dashboard/project/<project-id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here  # Server-side only, never expose to client

# -----------------------------------------------------------------------------
# INNGEST (Background Jobs & Scheduled Functions)
# -----------------------------------------------------------------------------
# Get these from: https://app.inngest.com/clients/<app-id>/settings
INNGEST_SIGNING_KEY=signkey-xxxxxxxxxxxxxxxx  # Used to verify webhook signatures
INNGEST_EVENT_KEY=eventkey-xxxxxxxxxxxxxxxx   # Used to send events from server
INNGEST_DEV=false                             # Set to true for local dev with inngest-cli dev

# -----------------------------------------------------------------------------
# RESEND (Transactional Emails)
# -----------------------------------------------------------------------------
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Muze Satwik <noreply@yourdomain.com>
RESEND_REPLY_TO=support@yourdomain.com

# -----------------------------------------------------------------------------
# GOOGLE OAUTH (Authentication & Calendar Sync)
# -----------------------------------------------------------------------------
# Get these from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
# For local dev: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Google Calendar API scopes (space-separated)
# https://www.googleapis.com/auth/calendar.events - Read/write calendar events
# https://www.googleapis.com/auth/calendar.readonly - Read-only access
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
# The canonical URL of your deployed application
# Local: http://localhost:3000
# Preview: https://muze-satwik-task-manager-preview.pages.dev
# Production: https://muze-satwik-task-manager.pages.dev or your custom domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# App metadata for PWA manifest and SEO
NEXT_PUBLIC_APP_NAME=Muze Satwik Task Manager
NEXT_PUBLIC_APP_DESCRIPTION=A beautiful, offline-first task manager with Google Calendar sync
NEXT_PUBLIC_APP_THEME_COLOR=#6366f1

# -----------------------------------------------------------------------------
# CRON & SCHEDULED JOBS
# -----------------------------------------------------------------------------
# Secret used to authenticate cron job requests (generate with: openssl rand -hex 32)
CRON_SECRET=your-cron-secret-here

# -----------------------------------------------------------------------------
# FEATURE FLAGS (Optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_CALENDAR_SYNC=true
NEXT_PUBLIC_ENABLE_EMAIL_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# -----------------------------------------------------------------------------
# DEVELOPMENT ONLY (Optional)
# -----------------------------------------------------------------------------
# Uncomment for local development with Supabase local stack
# SUPABASE_LOCAL_URL=http://localhost:54321
# SUPABASE_LOCAL_ANON_KEY=your-local-anon-key

# Uncomment to enable debug logging
# DEBUG=inngest:*
# LOG_LEVEL=debug